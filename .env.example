# Docker Compose. Host is the service name, not localhost.
# For running the backend outside Docker, use backend/.env instead.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airport
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/airport

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=airport-investment-agent

CORS_ORIGINS=http://localhost:5173

HTTP_TIMEOUT_SECONDS=10.0

# Agent behaviour. Defaults shown; none of these change what a score means.
HISTORY_MESSAGES=6          # turns of context sent to the intent and narrate models
DEFAULT_RESULT_LIMIT=10     # rows a ranking shows, and the scope-question threshold
MAX_CLARIFY_ROUNDS=3        # asks per clarification before proceeding on an assumption
MAX_FACT_AIRPORTS=5         # named airports a direct question will look up
MAX_LIVE_LOOKUPS=5          # airports enriched with live FAA/OpenSky status
MAX_ATTRIBUTED_ROWS=10      # rows given a full score breakdown in the narrate payload

# Startup data acquisition.
WARM_ATTEMPTS=3
WARM_BACKOFF_SECONDS=2.0
T100_PAGE_SIZE=1000
